{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.topolograph/topolograph",
  "title": "Topolograph",
  "description": "OSPF and IS-IS topology, paths, failure impact, change events, MPLS TE and BGP from Topolograph",
  "websiteUrl": "https://topolograph.com",
  "repository": {
    "url": "https://github.com/Vadims06/topolograph-mcp-server",
    "source": "github"
  },
  "version": "1.8.0",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Vadims06/topolograph-mcp-server/main/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://topolograph.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API token created in Topolograph>; without it the client signs in through OAuth",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
